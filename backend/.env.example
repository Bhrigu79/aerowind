# ─── AEROWIND Backend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your values. NEVER commit .env.

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
SECRET_KEY=changeme-use-openssl-rand-hex-32-here

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
# Docker Compose local dev defaults — CHANGE in production.
POSTGRES_USER=aerowind
POSTGRES_PASSWORD=changeme-local-dev-only
POSTGRES_DB=aerowind
DATABASE_URL=postgresql+asyncpg://aerowind:changeme-local-dev-only@localhost:5432/aerowind
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ── Cache / Queue (Redis) ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Model Gateway ─────────────────────────────────────────────────────────────
MODEL_GATEWAY_DEFAULT_PROVIDER=nebius
MODEL_GATEWAY_TIMEOUT=60
MODEL_GATEWAY_MAX_RETRIES=3
MODEL_GATEWAY_RETRY_DELAY=1.0

# ── Nebius / NVIDIA Nemotron (PRIMARY) ───────────────────────────────────────
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1
NEBIUS_DEFAULT_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_REASONING_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NEBIUS_FAST_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
NEBIUS_ENABLED=true

# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini
OPENAI_ENABLED=false

# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest
ANTHROPIC_ENABLED=false

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-1.5-flash
GEMINI_ENABLED=false

# ── Object Storage (Nebius / S3-compatible) ───────────────────────────────────
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=aerowind-artifacts
STORAGE_REGION=eu-north1

# ── Experiment Sandbox ────────────────────────────────────────────────────────
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT=300
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_QUOTA=100000

# ── Observability ─────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | text
METRICS_ENABLED=true
METRICS_PORT=9090

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
